{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Monochrome Dark",
  "author": "Ported from mikehhodgson.monochrome-dark (VSCode)",
  "themes": [
    {
      "name": "Monochrome Dark",
      "appearance": "dark",
      "style": {
        "background": "#1a1a1a",
        "border": "#222426",
        "border.variant": "#222426",
        "border.focused": "#ffffff",
        "border.selected": "#606060",
        "border.transparent": "#00000000",
        "border.disabled": "#303030",
        "elevated_surface.background": "#1a1a1a",
        "surface.background": "#1a1a1a",
        "drop_target.background": "#22242680",

        "element.background": "#1a1a1a",
        "element.hover": "#303030",
        "element.active": "#606060",
        "element.selected": "#404040",
        "element.disabled": "#1a1a1a",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#303030",
        "ghost_element.active": "#606060",
        "ghost_element.selected": "#404040",
        "ghost_element.disabled": "#00000000",

        "text": "#ffffff",
        "text.muted": "#aaaaaa",
        "text.placeholder": "#888888",
        "text.disabled": "#606060",
        "text.accent": "#ffffff",
        "link_text.hover": "#00d9ff",
        "icon": "#ffffff",
        "icon.muted": "#aaaaaa",
        "icon.disabled": "#606060",
        "icon.placeholder": "#888888",
        "icon.accent": "#ffffff",

        "status_bar.background": "#000000",
        "title_bar.background": "#1a1a1a",
        "title_bar.inactive_background": "#1a1a1a",
        "toolbar.background": "#1a1a1a",
        "tab_bar.background": "#1a1a1a",
        "tab.active_background": "#303030",
        "tab.inactive_background": "#1a1a1a",
        "panel.background": "#1a1a1a",
        "panel.focused_border": "#ffffff",
        "panel.indent_guide": "#303030",
        "panel.indent_guide_active": "#888888",
        "panel.indent_guide_hover": "#888888",
        "pane.focused_border": "#00000000",
        "pane_group.border": "#222426",

        "scrollbar.thumb.background": "#60606080",
        "scrollbar.thumb.hover_background": "#ffffff80",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.background": "#1a1a1a",
        "editor.foreground": "#ffffff",
        "editor.gutter.background": "#1a1a1a",
        "editor.subheader.background": "#000000",
        "editor.active_line.background": "#303030",
        "editor.highlighted_line.background": "#303030",
        "editor.line_number": "#606060",
        "editor.active_line_number": "#ffffff",
        "editor.invisible": "#303030",
        "editor.wrap_guide": "#303030",
        "editor.active_wrap_guide": "#606060",
        "editor.indent_guide": "#303030",
        "editor.indent_guide_active": "#888888",
        "editor.document_highlight.read_background": "#60606066",
        "editor.document_highlight.write_background": "#60606099",
        "editor.document_highlight.bracket_background": "#606060",
        "search.match_background": "#606060",

        "error": "#ff0000",
        "error.background": "#000000",
        "error.border": "#ff0000",
        "warning": "#e6a23c",
        "warning.background": "#000000",
        "warning.border": "#e6a23c",
        "info": "#ffffff",
        "info.background": "#000000",
        "info.border": "#ffffff",
        "success": "#0dbc79",
        "success.background": "#000000",
        "success.border": "#0dbc79",
        "hint": "#606060",
        "hint.background": "#1a1a1a",
        "hint.border": "#222426",
        "predictive": "#606060",
        "predictive.background": "#1a1a1a",
        "predictive.border": "#222426",
        "unreachable": "#888888",
        "hidden": "#606060",
        "ignored": "#606060",
        "conflict": "#f78c00",
        "renamed": "#0c7d9d",
        "created": "#587c0c",
        "created.background": "#0096872d",
        "modified": "#0c7d9d",
        "modified.background": "#0c7d9d2d",
        "deleted": "#94151b",
        "deleted.background": "#ff00002d",

        "terminal.background": "#1a1a1a",
        "terminal.foreground": "#cccccc",
        "terminal.bright_foreground": "#ffffff",
        "terminal.dim_foreground": "#888888",
        "terminal.ansi.background": "#1a1a1a",
        "terminal.ansi.black": "#000000",
        "terminal.ansi.red": "#cd3131",
        "terminal.ansi.green": "#0dbc79",
        "terminal.ansi.yellow": "#e5e510",
        "terminal.ansi.blue": "#2472c8",
        "terminal.ansi.magenta": "#bc3fbc",
        "terminal.ansi.cyan": "#11a8cd",
        "terminal.ansi.white": "#e5e5e5",
        "terminal.ansi.bright_black": "#666666",
        "terminal.ansi.bright_red": "#f14c4c",
        "terminal.ansi.bright_green": "#23d18b",
        "terminal.ansi.bright_yellow": "#f5f543",
        "terminal.ansi.bright_blue": "#3b8eea",
        "terminal.ansi.bright_magenta": "#d670d6",
        "terminal.ansi.bright_cyan": "#29b8db",
        "terminal.ansi.bright_white": "#e5e5e5",

        "players": [
          {
            "cursor": "#ffffff",
            "background": "#ffffff",
            "selection": "#606060"
          }
        ],

        "syntax": {
          "attribute": { "color": "#969696" },
          "boolean": { "color": "#ffffff" },
          "comment": { "color": "#7a7a7a", "font_style": "normal" },
          "comment.doc": { "color": "#8a8a8a", "font_style": "normal" },
          "constant": { "color": "#ffffff" },
          "constructor": { "color": "#969696" },
          "embedded": { "color": "#ffffff" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#969696" },
          "function": { "color": "#ffffff" },
          "hint": { "color": "#606060" },
          "keyword": { "color": "#969696" },
          "label": { "color": "#969696" },
          "link_text": { "color": "#ffffff" },
          "link_uri": { "color": "#ffffff", "font_style": "italic" },
          "number": { "color": "#ffffff" },
          "operator": { "color": "#969696" },
          "predictive": { "color": "#606060", "font_style": "italic" },
          "preproc": { "color": "#969696" },
          "primary": { "color": "#ffffff" },
          "property": { "color": "#ffffff" },
          "punctuation": { "color": "#969696" },
          "punctuation.bracket": { "color": "#969696" },
          "punctuation.delimiter": { "color": "#969696" },
          "punctuation.list_marker": { "color": "#ffffff" },
          "punctuation.special": { "color": "#969696" },
          "string": { "color": "#ffffff" },
          "string.escape": { "color": "#d2d2d2" },
          "string.regex": { "color": "#ffffff" },
          "string.special": { "color": "#ffffff" },
          "string.special.symbol": { "color": "#ffffff" },
          "tag": { "color": "#ffffff" },
          "text.literal": { "color": "#ffffff" },
          "title": { "color": "#ffffff", "font_weight": 700 },
          "type": { "color": "#969696" },
          "variable": { "color": "#ffffff" },
          "variable.special": { "color": "#ffffff", "font_style": "italic" },
          "variant": { "color": "#969696" }
        }
      }
    }
  ]
}
